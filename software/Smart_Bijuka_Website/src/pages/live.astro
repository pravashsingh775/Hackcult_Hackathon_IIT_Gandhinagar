---
import AppLayout from "../layouts/AppLayout.astro";
import LiveMonitor from "../components/LiveMonitor";
import { Radio, ArrowRight } from "@lucide/astro";
---

<AppLayout
  title="Live Monitor · Smart Bijuka"
  description="Watch your fields live, trigger species-specific audio deterrence, and control the 180° servo scarecrow from anywhere."
>
  <section id="live-monitor" class="border-b border-border bg-secondary/40">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
      <span class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
        <Radio class="size-3.5" aria-hidden="true" />
        Streaming · CAM-01
      </span>
      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Live monitor & remote control</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground sm:text-base">
        Real-time video from the ESP32-CAM with on-device YOLOv8 classification. Pick a deterrent
        sound, adjust adaptive intensity, and drive the 180° servo scarecrow — all remotely,
        exactly as the upcoming mobile app will.
      </p>
    </div>
  </section>

  <section id="monitor-controls" class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <LiveMonitor client:load />
    <div class="mt-6 flex flex-col items-start justify-between gap-3 rounded-xl border border-border bg-muted/40 p-5 sm:flex-row sm:items-center">
      <p class="text-sm text-muted-foreground">
        Intrusion alerts are pushed to your phone the moment PIR + vision confirm an animal. Review
        every event in the history log.
      </p>
      <div class="flex shrink-0 gap-3">
        <a href="/history" class="inline-flex h-9 items-center gap-2 rounded-md border border-input bg-background px-4 text-sm font-medium shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground">
          Event history <ArrowRight class="size-4" aria-hidden="true" />
        </a>
        <a href="/insights" class="inline-flex h-9 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
          AI insights
        </a>
      </div>
    </div>
  </section>
</AppLayout>
