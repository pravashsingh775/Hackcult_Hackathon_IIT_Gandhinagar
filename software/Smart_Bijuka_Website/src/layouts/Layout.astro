---
import '../styles/global.css';
import RequiredB12HeadScripts from '../components/RequiredB12HeadScripts.astro';
import RequiredB12FooterScripts from '../components/RequiredB12FooterScripts.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Smart Bijuka — AI-Enabled Smart DigiKhet Protector',
  description = 'Smart Bijuka is an intelligent field guardian combining PIR motion detection, ESP32-CAM monitoring, and YOLOv8 vision to classify and deter crop intruders.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <RequiredB12HeadScripts />
  </head>

  <body class="min-h-screen flex flex-col">
    <slot />
    <Footer />
    <RequiredB12FooterScripts />
  </body>
</html>
