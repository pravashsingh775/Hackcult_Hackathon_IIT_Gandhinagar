# Smart Bijuka — Backend Configuration
# ---------------------------------------------
HOST=127.0.0.1
PORT=8000
MODEL_PATH=../yolov8n.pt

# Selective Deterrence Defaults
CONFIDENCE_THRESHOLD=0.50
COOLDOWN_SECONDS=6.0

# Supported Deterrent Animals (COCO class names from YOLOv8)
# Human ('person') is strictly excluded from deterrence
SUPPORTED_ANIMAL_CLASSES=bird,cat,dog,horse,sheep,cow,elephant,bear,zebra,giraffe

# Physical Hardware Actuation (Disabled by default - Safe Simulation Mode)
HARDWARE_ENABLED=false
HARDWARE_TYPE=simulation
ESP32_IP=192.168.1.150
ESP32_PORT=80
ESP32_SERIAL_PORT=COM3
ESP32_BAUD_RATE=115200

# Audio settings
DEFAULT_AUDIO_FILE=animal_alert.mp3
AUDIO_ENABLED=true
AUDIO_VOLUME=0.85

